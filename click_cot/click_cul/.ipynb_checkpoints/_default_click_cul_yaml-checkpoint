dataset_path: EunsuKim/CLIcK
test_split: train
fewshot_split: train
output_type: generate_until
doc_to_text: !function utils.get_context
# doc_to_choice: !function utils.get_choices
doc_to_target: !function utils.get_target
filter_list:
  - name: "flexible-extract"
    filter:
      - function: "regex"
        group_select: -1
        regex_pattern: "[^a-zA-Z0-9]([A-Z])[^a-zA-Z0-9]"
  - name: "answer-is-correct-is"
    filter:
      - function: "regex"
        group_select: -1
        regex_pattern: "정답은 [\\'\\*]*\\(?([A-Z])\\)?[\\'\\*]*|답은 [\\'\\*]*\\(?([A-Z])\\)?[\\'\\*]*|정답: [\\'\\*]*\\(?([A-Z])\\)?[\\'\\*]*|답: [\\'\\*]*\\(?([A-Z])\\)?[\\'\\*]*|[\\'\\*]*\\(?([A-Z])\\)?[\\'\\*]*.+[은는이가] 올바른|[\\'\\*]*\\(?([A-Z])\\)?[\\'\\*]*.+[은는이가] 정답|\\\boxed\\{\\(?([A-Z])\\)?\\}"
  - name: "get-answer"
    filter:
      - function: "regex"
        regex_pattern: "(?<=정답은)(.*)(?=입니다.)"
        regex_pattern: "(?<=정답은)\\s*[(]?(A|B|C|D)[)]?.*(?=입니다.)"
      - function: "take_first"
generation_kwargs:
  until:
    - "Question:"
  max_gen_toks: 8192
  do_sample: true
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
